# AI Coach Configuration (Server-side only - never exposed to browser)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom model (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: Gemini API key (for Gemini provider)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Claude API key (for Claude provider)
# CLAUDE_API_KEY=your_claude_api_key_here

# Optional: OpenRouter API key (for OpenRouter provider)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
